# Postgres connection string (Railway provides this automatically when you attach a Postgres plugin)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Your Anthropic API key — server-side only, never exposed to the browser
ANTHROPIC_API_KEY="sk-ant-..."

# NextAuth — generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Set to your deployed URL once you have one, e.g. https://forecast.up.railway.app
NEXTAUTH_URL="http://localhost:3000"
