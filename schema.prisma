generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String?
  createdAt    DateTime       @default(now())
  forecasts    ForecastRun[]
  subscription Subscription?
}

model ForecastRun {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lang         String   @default("en")
  situation    String
  context      String?
  profileJson  Json
  analysisJson Json?
  forecastJson Json?
  outcomeJson  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Not wired to Stripe yet — schema is ready so billing can be added without a migration rewrite.
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                 String    @default("free") // free | pro | premium
  status               String    @default("inactive") // inactive | active | canceled | past_due
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}
